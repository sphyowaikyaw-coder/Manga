@model WebApp.View_Model.RegisterViewModel
@{
    Layout = "MainLayout";
    ViewData["Title"] = "Register";
}

<section class="auth-band">
    <div class="auth-card">
        <span class="eyebrow">Reader account</span>
        <h1>Join MangaVerse</h1>
        <form asp-action="Register" method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <label asp-for="UserName"></label>
            <input asp-for="UserName" placeholder="Your display name">
            <span asp-validation-for="UserName"></span>
            <label asp-for="Email"></label>
            <input asp-for="Email" placeholder="you@example.com">
            <span asp-validation-for="Email"></span>
            <label asp-for="Password"></label>
            <input asp-for="Password" placeholder="At least 6 characters">
            <span asp-validation-for="Password"></span>
            <button type="submit" class="pill-button">Create Account</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
