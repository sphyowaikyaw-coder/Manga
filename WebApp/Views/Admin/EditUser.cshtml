@model WebApp.View_Model.AdminUserItem
@{
    Layout = "MainLayout";
    ViewData["Title"] = "Edit User";
}

<section class="content-band dashboard-band">
    <div class="container">
        <div class="section-heading">
            <h2>Edit User</h2>
            <a class="ghost-button" asp-controller="Admin" asp-action="Users">Back to Users</a>
        </div>
        <form method="post" class="admin-form">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden">
            <label asp-for="Name"></label>
            <input asp-for="Name">
            <label asp-for="Email"></label>
            <input asp-for="Email">
            <label asp-for="Role"></label>
            <select asp-for="Role">
                <option>User</option>
                <option>Admin</option>
                <option>Creator</option>
            </select>
            <label asp-for="Joined"></label>
            <input asp-for="Joined">
            <div class="form-actions">
                <button class="pill-button" type="submit">Save User</button>
                <a class="ghost-button" asp-controller="Admin" asp-action="Users">Cancel</a>
            </div>
        </form>
    </div>
</section>
