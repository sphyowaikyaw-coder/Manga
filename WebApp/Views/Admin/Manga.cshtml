@model IReadOnlyList<WebApp.View_Model.MangaItem>
@{
    Layout = "MainLayout";
    ViewData["Title"] = "Manage Manga";
    var searchQuery = ViewData["SearchQuery"] as string ?? string.Empty;
}

<section class="content-band dashboard-band">
    <div class="container">
        <div class="section-heading">
            <h2>Manage Manga</h2>
            <div>
                <a class="ghost-button " asp-controller="Admin" asp-action="Index"><i class="fa-solid fa-circle-chevron-left"></i></a>
                <a class="pill-button" asp-controller="Admin" asp-action="AddManga">Add Manga</a>
            </div>
            
        </div>
        <form class="admin-search" asp-controller="Admin" asp-action="Manga" method="get">
            <input type="search" id="AdminsearchBox" name="q" value="@searchQuery" placeholder="Search by title, author, status, genre">
           
            <button class="pill-button" type="submit">Search</button>
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <a class="ghost-button" asp-controller="Admin" asp-action="Manga">Clear</a>
            }
        </form>
        <div id="AdminsearchResults"
             class="list-group position-absolute w-50 bg-white"
             style="z-index:1000; top: 200px;">
        </div>
        @if (TempData["AdminMessage"] is string message)
        {
            <div class="admin-alert">@message</div>
        }
        <div class="admin-table">
            <div class="table-row table-head">
                <span>Title</span>
                <span>Status</span>
                <span>Chapters</span>
                <span>Rating</span>
                <span>Action</span>
            </div>
            @foreach (var manga in Model)
            {
                <div class="table-row">
                    <span>@manga.Title</span>
                    <span>@manga.Status</span>
                    <span>@manga.Chapters</span>
                    <span>@manga.Rating</span>
                    <span class="table-actions">
                        <a class="table-action" asp-controller="Admin" asp-action="EditManga" asp-route-id="@manga.Id">Edit</a>
                        <a class="table-action" asp-controller="Admin" asp-action="AddChapter" asp-route-mangaId="@manga.Id">Add Chapter</a>
                        <a class="table-action" asp-controller="Admin" asp-action="ChapterLists" asp-route-Id="@manga.Id">Chapter Lists</a>

                        <button id="deleteChapter" data-id="@manga.Id" class="delete-chapter-btn table-action text-danger bg-transparent border-0">Delete Chapter</button>

                        <button id="deleteManga" data-id="@manga.Id" class="delete-manga-btn table-action text-danger bg-transparent border-0">Delete</button>

                    </span>
                </div>
            }
        </div>
        @if (Model.Count == 0)
        {
            <p class="empty-state">No manga found.</p>
        }
    </div>

</section>

<script nonce="@Context.Items["CSP-Nonce"]">


    // document.getElementById("deleteChapter").addEventListener("click", function () {
    //     let mangaId = this.getAttribute("data-id");
    //     deleteChapter(mangaId);
    // });

        document.getElementById("AdminsearchBox").addEventListener("keyup", function () {

        let keyword = this.value.trim();

        if (keyword.length < 1) {
            document.getElementById("AdminsearchResults").innerHTML = "";
            return;
        }

        const baseUrl = "@Url.Action("SearchManga", "Manga")";

        fetch(`${baseUrl}?keyword=${encodeURIComponent(keyword)}`)
            .then(response => response.json())
            .then(data => {
                let html = "";
                const detailBaseUrl = "@Url.Action("ClickManga", "Admin")";

                data.forEach(manga => {
                    // Use a standard form layout for each search result
                    html += `
                        <form action="${detailBaseUrl}" method="post" class="d-inline w-100">
                            <input type="hidden" name="id" value="${manga.mangaId}" />

                            <button type="submit" class="list-group-item list-group-item-action text-start border-0 bg-transparent w-100 p-3">
                                <div class="d-flex align-items-center">
                                    <img src="${manga.coverImage}"
                                         width="50"
                                         height="70"
                                         class="me-2"
                                         alt="${manga.title}">
                                    <span>${manga.title}</span>
                                </div>
                            </button>
                        </form>
                    `;
                });
                document.getElementById("AdminsearchResults").innerHTML = html;
            })
            .catch(error => console.error("Search failed:", error));
    });



    document.addEventListener("DOMContentLoaded", function () {

    document.querySelectorAll(".delete-chapter-btn").forEach(button => {
        button.addEventListener("click", function () {
            let mangaId = this.getAttribute("data-id");
            deleteChapter(mangaId);
        });
    });
    })


    // document.getElementById("deleteManga").addEventListener("click", function () {
    //     let mangaId = this.getAttribute("data-id");
    //     deleteManga(mangaId);
    // });

     document.querySelectorAll(".delete-manga-btn").forEach(button => {
        button.addEventListener("click", function () {
            let mangaId = this.getAttribute("data-id");
            deleteManga(mangaId);
        });
    });


    async function deleteManga(mangaId) {
        const result = await Swal.fire({
            title: 'Delete Manga',
            text: 'Are you sure you want to delete this manga and all its chapters?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Delete',
            cancelButtonText: 'Cancel'
        });
        const url = "@Url.Action("DeleteManga", "Admin")";
        if (!result.isConfirmed) return;
            fetch(url, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ IdforDelete: mangaId })
    })
    .then(res => res.json())
    .then(async data => {

        const result = await Swal.fire({
            icon: 'success',
            title: 'Success',
            text: data.message,
            confirmButtonText: 'OK'
        });

        if (result.isConfirmed) {
            location.reload();
        }
    });
    }

    async function deleteChapter(mangaId) {

        const result = await Swal.fire({
            title: 'Delete Chapter',
            text: 'Enter chapter number to delete',
            input: 'number',
            inputPlaceholder: 'Chapter number...',
            showCancelButton: true,
            confirmButtonText: 'Delete', 
            cancelButtonText: 'Cancel'
        });

        if (!result.isConfirmed || !result.value) return;

        let chapterNo = result.value;

        const url = "@Url.Action("DeleteChapter", "Admin")";
        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                Id: mangaId,
                chapterNumber: chapterNo
            })
        })
            .then(res => res.json())
          .then(data => {
        
        Swal.fire('Success', data.message, 'success')
        .then((result) => {
          
            if (result.isConfirmed || result.isDismissed) {
                location.reload();
            }
        });
    });
    }
</script>