@model WebApp.View_Model.MangaItem
@{
    Layout = "MainLayout";
    ViewData["Title"] = @Model.Title;
    var searchQuery = ViewData["SearchQuery"] as string ?? string.Empty;
}

<section class="content-band dashboard-band">
    <div class="container">
        <div class="section-heading">
            <h2>Chapter Lists </h2>
            <div>
                <a class="ghost-button " asp-controller="Admin" asp-action="Index"><i class="fa-solid fa-circle-chevron-left"></i></a>
                <a class="table-action" asp-controller="Admin" asp-action="AddChapter" asp-route-mangaId=@Model.Id>Add Chapter</a>

            </div>

        </div>
        <form class="admin-search" asp-controller="Admin" asp-action="ChapterLists" method="get">
            <input type="search" id="searchBox" name="q" value="@searchQuery" placeholder="Search by title, author, status, genre">
            <div id="searchResults"
                 class="list-group position-absolute w-100"
                 style="z-index:1000; top: 200px;">
            </div>
            <button class="pill-button" type="submit">Search</button>
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <a class="ghost-button" asp-controller="Admin" asp-action="ChapterLists">Clear</a>
            }
        </form>
        @if (TempData["AdminMessage"] is string message)
        {
            <div class="admin-alert">@message</div>
        }
        <div class="admin-table">
            <div class="table-row table-head">
                <span>ChapterNo.</span>
                <span>ChapterTitle</span>
                <span>ChapterUrl</span>
                <span>Action</span>
            </div>
            @foreach (var chapter in Model.ChapterLists)
            {
                <div class="table-row">
                <input type="hidden" name="chapterId" value="@chapter.ChapterId" />
                    <span>@chapter.ChapterNumber.ToString()</span>
                    <span>@chapter.Title</span>
                    <span>@chapter.ChapterUrl</span>
                    
                    <span class="table-actions">
                        <a class="table-action" asp-controller="Admin" asp-action="EditChapter" asp-route-Chapterid=@chapter.ChapterId>Edit Chapter</a>


                        <button class="table-action delete-chapter-btn text-danger bg-transparent border-0">Delete Chapter</button>


                    </span>
                </div>
            }
        </div>
        @if (Model.ChapterLists.Count == 0)
        {
            <p class="empty-state">No manga found.</p>
        }
    </div>

</section>

<script>
    document.querySelectorAll(".delete-chapter-btn").forEach(button => {
        button.addEventListener("click", function () {
            let mangaId = this.getAttribute("data-id");
            deleteChapter(mangaId);
        });
    });

    document.getElementById("searchBox").addEventListener("keyup", function () {

        let keyword = this.value;

        // if (keyword.length < 1) {
        //     document.getElementById("searchResults").innerHTML = "";
        //     return;
        // }

        fetch(`/Manga/SearchManga?keyword=${keyword}`)
            .then(response => response.json())
            .then(data => {

                let html = "";

                data.forEach(manga => {

                    html += `
                        <a href="/Admin/ClickManga/${manga.mangaId}"
                           class="list-group-item list-group-item-action">

                            <div class="d-flex align-items-center">
                                <img src="${manga.coverImage}"
                                     width="50"
                                     height="70"
                                     class="me-2">

                                <span>${manga.title}</span>
                            </div>

                        </a>
                    `;
                });

                document.getElementById("searchResults").innerHTML = html;
            });
    });

    async function deleteManga(mangaId) {
        const result = await Swal.fire({
            title: 'Delete Manga',
            text: 'Are you sure you want to delete this manga and all its chapters?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Delete',
            cancelButtonText: 'Cancel'
        });
        if (!result.isConfirmed) return;
            fetch('/Admin/DeleteManga', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ IdforDelete: mangaId })
    })
    .then(res => res.json())
    .then(async data => {

        const result = await Swal.fire({
            icon: 'success',
            title: 'Success',
            text: data.message,
            confirmButtonText: 'OK'
        });

        if (result.isConfirmed) {
            location.reload();
        }
    });
    }

    async function deleteChapter(mangaId) {

        const result = await Swal.fire({
            title: 'Delete Chapter',
            text: 'Enter chapter number to delete',
            input: 'number',
            inputPlaceholder: 'Chapter number...',
            showCancelButton: true,
            confirmButtonText: 'Delete',
            cancelButtonText: 'Cancel'
        });

        if (!result.isConfirmed || !result.value) return;

        let chapterNo = result.value;

        fetch('/Admin/DeleteChapter', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                Id: mangaId,
                chapterNumber: chapterNo
            })
        })
        .then(res => res.json())
        .then(data => {
            Swal.fire('Success', data.message, 'success');
        }).then((result) => {

        if (result.isConfirmed) {
            location.reload();
        }
        });
    }
</script>